# Public build-time configuration. Copy to /opt/snapvocab/admin/.env.production.
# Same-origin requests are forwarded by host Nginx to the backend on Oracle.
VITE_API_BASE_URL=
VITE_ADMIN_BADGES_ENABLED=true
VITE_ADMIN_MISSIONS_ENABLED=true
VITE_ADMIN_DEMO=false
VITE_ADMIN_OVERVIEW_FIXTURES=false
VITE_ADMIN_ANALYTICS_FIXTURES=false
VITE_ADMIN_LEARNERS_FIXTURES=false
VITE_ADMIN_BADGES_FIXTURES=false
VITE_ADMIN_TEMPLATES_FIXTURES=false
VITE_ADMIN_AUDIT_FIXTURES=false
VITE_ADMIN_LEADERBOARD_FIXTURES=false
