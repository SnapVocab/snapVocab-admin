# Copy to .env before running npm run dev.
# Leave empty to use /api through the dev proxy or a production reverse proxy.
# For direct requests, set the backend origin, e.g. https://api.example.com (without /api).
VITE_API_BASE_URL=

# Used only by the Vite dev server when proxying /api. Not exposed to the browser.
API_PROXY_TARGET=http://localhost:8080

# Existing feature flags. .env.local can override these values.
VITE_ADMIN_BADGES_ENABLED=true
VITE_ADMIN_MISSIONS_ENABLED=false
VITE_ADMIN_DEMO=false

# Sample data: true = fixtures, false = API.
# If omitted, fixtures default to enabled in dev and disabled in production.
# Some endpoints are proposed and may not exist on the backend yet.
VITE_ADMIN_OVERVIEW_FIXTURES=true
VITE_ADMIN_ANALYTICS_FIXTURES=true
# VITE_ADMIN_LEARNERS_FIXTURES=false
# VITE_ADMIN_BADGES_FIXTURES=false
# VITE_ADMIN_TEMPLATES_FIXTURES=false
# VITE_ADMIN_AUDIT_FIXTURES=false
# VITE_ADMIN_LEADERBOARD_FIXTURES=true   # sample board instead of GET /api/admin/leaderboards
